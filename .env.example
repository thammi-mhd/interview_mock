# Environment Variables Template
# Copy this to .env and fill in your values

# ============== DATABASE ==============
DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_db

# ============== SECURITY ==============
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=ikndbckasbdcibuqervuqeornvfcajnq

# ============== GEMINI API ==============
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============== SPEECH-TO-TEXT (WHISPER) ==============
# Use fine-tuned Whisper model for accurate audio transcription
# Set to false to fall back to Google Speech Recognition
USE_WHISPER_MODEL=true
# Path to the fine-tuned Whisper model directory
WHISPER_MODEL_PATH=./speech-recognition/whisper-finetuned

# ============== EMAIL CONFIGURATION ==============
# For Gmail: Use App Specific Password (not your regular password)
# See: https://myaccount.google.com/apppasswords

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
SENDER_EMAIL=your-email@gmail.com

# ============== OTP SETTINGS ==============
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# ============== JWT SETTINGS ==============
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============== INTERVIEW SETTINGS ==============
INTERVIEW_QUESTIONS_COUNT=10
QUESTION_TIME_LIMIT_SECONDS=120

# ============== SECURITY SETTINGS ==============
PASSWORD_MIN_LENGTH=8

# ============== CORS ==============
# For production, specify allowed origins instead of "*"
# Example: CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]
CORS_ORIGINS=*
