# ============================================
# Intervuo Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# For Render: set these in Dashboard → Environment

# ============== DATABASE ==============
# Supabase PostgreSQL connection string
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ============== SECURITY ==============
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_32_char_string

# ============== GEMINI API ==============
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============== EMAIL (Gmail SMTP) ==============
# For Gmail: Use App Specific Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=noreply.intervuo@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
SENDER_EMAIL=noreply.intervuo@gmail.com

# ============== ENVIRONMENT ==============
# Set to "production" on Render, "development" locally
ENVIRONMENT=development

# ============== CORS ==============
# Your Vercel frontend URL (required in production)
# Multiple origins: comma-separated
# Example: https://intervuo.vercel.app,https://www.intervuo.com
CORS_ORIGINS=http://localhost:3000

# ============== FRONTEND URL ==============
# Used in email verification links
# Must match your deployed frontend URL in production
FRONTEND_URL=http://localhost:3000
