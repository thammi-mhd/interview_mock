# ============================================
# Intervuo Frontend — Environment Variables
# ============================================
# Copy this to .env.local and fill in your values
# For Vercel: set these in Project Settings → Environment Variables

# Backend API URL
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (set this on Vercel):
# NEXT_PUBLIC_API_URL=https://intervuo-api.onrender.com
